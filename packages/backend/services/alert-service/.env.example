# Service Configuration
NODE_ENV=development
PORT=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nibe_dim

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=

# TimescaleDB (data-service & analytics-service only)
TIMESCALE_URI=postgresql://postgres:postgres@localhost:5432/nibe_dim

# MQTT (control-service only)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Auth (gateway-service & user-service only)
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# External Services
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SLACK_WEBHOOK_URL=
